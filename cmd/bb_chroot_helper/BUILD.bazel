load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "config",
    srcs = ["config.cc"],
    hdrs = ["config.h"],
    copts = ["-std=c++17"],
    deps = ["@cli11"],
)

cc_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":config",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "bb_chroot_helper_lib",
    srcs = [
        "main.cc",
        "mount.cc",
        "mount.h",
    ],
    copts = ["-std=c++17"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":config"],
)

cc_binary(
    name = "bb_chroot_helper",
    copts = ["-std=c++17"],
    # Produce a fully static binary as we run distroless.
    features = [
        "fully_static_link",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [":bb_chroot_helper_lib"],
)

# Useful when cross-compiling from other platforms.
platform_transition_binary(
    name = "bb_chroot_helper_linux_musl",
    binary = ":bb_chroot_helper",
    target_platform = "//build/platforms:linux_x86_64_musl",
)
