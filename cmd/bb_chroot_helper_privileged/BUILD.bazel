load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "bb_chroot_helper_privileged_lib",
    srcs = ["main.go"],
    importpath = "github.com/buildbarn/bb-action-router/cmd/bb_chroot_helper_privileged",
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/actionrouter",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/actionrouter",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "bb_chroot_helper_privileged",
    embed = [":bb_chroot_helper_privileged_lib"],
    # Static pure-Go binary so it runs on the runner without a musl/glibc loader.
    pure = "on",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
