# gazelle:ignore

load("@rules_go//extras:gomock.bzl", "gomock")
load("@rules_go//go:def.bzl", "go_library")

gomock(
    name = "blobstore",
    out = "blobstore.go",
    interfaces = ["BlobAccess"],
    library = "@com_github_buildbarn_bb_storage//pkg/blobstore",
    mockgen_tool = "@org_uber_go_mock//mockgen",
    package = "mock",
    source = "@com_github_buildbarn_bb_storage//pkg/blobstore:blob_access.go",
)

go_library(
    name = "mock",
    srcs = [
        ":blobstore.go",
    ],
    importpath = "github.com/buildbarn/bb-action-router/internal/mock",
    visibility = ["//:__subpackages__"],
    deps = [
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_go_proto",
        "@com_github_buildbarn_bb_storage//pkg/blobstore",
        "@com_github_buildbarn_bb_storage//pkg/digest",
        "@org_uber_go_mock//gomock",
    ],
)
