load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "build_user_proto",
    srcs = ["build_user.proto"],
    import_prefix = "github.com/buildbarn/bb-action-router",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "build_user_go_proto",
    importpath = "github.com/buildbarn/bb-action-router/pkg/proto/configuration/build_user",
    proto = ":build_user_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "build_user",
    embed = [":build_user_go_proto"],
    importpath = "github.com/buildbarn/bb-action-router/pkg/proto/configuration/build_user",
    visibility = ["//visibility:public"],
)
