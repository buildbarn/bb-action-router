load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "registry_auth_proto",
    srcs = ["registry_auth.proto"],
    import_prefix = "github.com/buildbarn/bb-action-router",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "registry_auth_go_proto",
    importpath = "github.com/buildbarn/bb-action-router/pkg/proto/configuration/registry_auth",
    proto = ":registry_auth_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "registry_auth",
    embed = [":registry_auth_go_proto"],
    importpath = "github.com/buildbarn/bb-action-router/pkg/proto/configuration/registry_auth",
    visibility = ["//visibility:public"],
)
