module(name = "com_github_buildbarn_bb_action_router")

bazel_dep(name = "bazel_lib", version = "3.3.1")
bazel_dep(name = "bazel_remote_apis")
bazel_dep(name = "com_github_buildbarn_bb_remote_execution")
bazel_dep(name = "com_github_buildbarn_bb_storage")
bazel_dep(name = "com_github_buildbarn_go_xdr")
bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "googleapis", version = "0.0.0-20260525-ef19b7b7")

bazel_dep(name = "googletest", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "35.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_img", version = "0.3.11")
bazel_dep(name = "rules_jsonnet", version = "0.7.2")
bazel_dep(name = "toolchains_llvm", version = "1.7.0")
bazel_dep(name = "toolchains_musl", version = "0.1.27.bcr.1")

# bb-storage, bb-remote-execution and go-xdr are not published to any Bazel
# registry.
git_override(
    module_name = "bazel_remote_apis",
    commit = "becdd8f9ff811df88a22d3eadd6341753d51d167",
    patches = ["//:patches/bazel_remote_apis/upstream-pr-378.diff"],
    remote = "https://github.com/bazelbuild/remote-apis.git",
)

git_override(
    module_name = "com_github_buildbarn_bb_storage",
    commit = "3991d6ebefb4cfc7c1956caaba5a28d1b2eca927",
    remote = "https://github.com/buildbarn/bb-storage.git",
)

git_override(
    module_name = "com_github_buildbarn_bb_remote_execution",
    commit = "c48dcda5e792227f50ec5bae0fcec1ab2e40fb48",
    remote = "https://github.com/buildbarn/bb-remote-execution.git",
)

git_override(
    module_name = "com_github_buildbarn_go_xdr",
    commit = "236788cf9e8948a1e8875c7dd243e2be180cdfd7",
    remote = "https://github.com/buildbarn/go-xdr.git",
)

# Every googletest release up to 1.17.0.bcr.2 has a BUILD file that calls
# cc_library/cc_test without loading them, which Bazel 9 rejects. The loads
# landed after 1.17.0, so take it from git until there's a release with them.
# See https://github.com/google/googletest/discussions/4922.
git_override(
    module_name = "googletest",
    commit = "3ff51c3e80f2c2eb105d43ecb9acab9a62e01600",
    remote = "https://github.com/google/googletest.git",
)

# Pulled in transitively by com_github_buildbarn_go_xdr; not in the registry.
git_override(
    module_name = "rules_antlr",
    commit = "89a29cca479363a5aee53e203719510bdc6be6ff",
    patches = [
        "//:patches/rules_antlr/antlr-4.10.diff",
        "//:patches/rules_antlr/bzlmod.diff",
        "//:patches/rules_antlr/load.diff",
    ],
    remote = "https://github.com/marcohu/rules_antlr.git",
)

single_version_override(
    module_name = "toolchains_llvm",
    patches = ["//:patches/toolchains_llvm/non-root.diff"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Header-only TOML parser, used by bb_chroot_helper to read its config file.
# Not published to any Bazel registry, so it's pulled in directly.
http_archive(
    name = "tomlplusplus",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "tomlplusplus",
    hdrs = ["toml.hpp"],
    defines = [
        "TOML_EXCEPTIONS=0",
        "TOML_ENABLE_FORMATTERS=0",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155",
    strip_prefix = "tomlplusplus-3.4.0",
    urls = ["https://github.com/marzer/tomlplusplus/archive/refs/tags/v3.4.0.tar.gz"],
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "cc_mvdan_gofumpt",
    "com_github_bazelbuild_remote_apis",
    "com_github_golang_mock",
    "com_github_google_go_containerregistry",
    "com_github_patrickmn_go_cache",
    "com_github_prometheus_client_golang",
    "com_github_stretchr_testify",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_sdk_metric",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_lint",
    "org_golang_x_sync",
    "org_golang_x_sys",
)

go_deps_dev = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.module_override(
    patches = ["@com_github_buildbarn_bb_storage//:patches/org_golang_x_lint/generic.diff"],
    path = "golang.org/x/lint",
)
go_deps_dev.module_override(
    patches = ["@com_github_buildbarn_bb_storage//:patches/cc_mvdan_gofumpt/unused-receiver-idents.diff"],
    path = "mvdan.cc/gofumpt",
)

# bb-storage's pkg/filesystem references unix.O_SEARCH, which x/sys does not
# define for Darwin
go_deps_dev.module_override(
    patches = ["//:patches/org_golang_x_sys/o-search.diff"],
    path = "golang.org/x/sys",
)

# Makes it possible to cross-compile and simplifies building static binaries.
toolchains_musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl", dev_dependency = True)
toolchains_musl.config(
    extra_target_compatible_with = ["@//build/linker_config:musl"],
)

# Force musl toolchain to have higher priority than the rules_cc one.
use_repo(toolchains_musl, "musl_toolchains_hub")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    llvm_version = "17.0.6",
)

register_toolchains(
    "@musl_toolchains_hub//:all",
    dev_dependency = True,
)
